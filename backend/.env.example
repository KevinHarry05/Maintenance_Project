DATABASE_URL=sqlite+aiosqlite:///./sbms.db
SECRET_KEY=replace_with_a_strong_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
COMPLAINT_UPLOAD_DIR=uploads/complaints
GLOBAL_RATE_LIMIT_PER_MINUTE=200
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
MAX_LOGIN_ATTEMPTS=5
FCM_SERVER_KEY=
ENABLE_CELERY_HEALTH_CHECK=false

# Token Blacklist Configuration (Requirement 4)
TOKEN_BLACKLIST_CLEANUP_HOUR=2
TOKEN_BLACKLIST_CACHE_TTL_SECONDS=300

# Email Verification Configuration (Requirement 5)
EMAIL_VERIFICATION_ENABLED=true
VERIFICATION_TOKEN_EXPIRY_HOURS=24
RESEND_EMAIL_RATE_LIMIT=3
RESEND_EMAIL_RATE_LIMIT_WINDOW_MINUTES=60

# File Upload Configuration (Requirement 3)
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_SIZE_BYTES=10485760

# Password Security Configuration (Requirement 8)
PASSWORD_MIN_LENGTH=12
PASSWORD_COMPLEXITY_REQUIRED=true

# Email Domain Configuration (Phase 3.1)
DOMAIN=localhost:8000

# SMTP Configuration for Email (Phase 3.8)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@sbms.app
SMTP_FROM_NAME=SBMS
